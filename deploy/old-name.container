[Unit]
Description=Old Name - rumor engine

[Container]
Image=localhost/old-name:latest
ContainerName=old-name
Network=host
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=NORN_KEEP_ALIVE=1m
Environment=NORN_VAULT=/app/data/vault.json
Environment=NORN_JOURNAL=/app/data/journal.json
Volume=%h/old-name-data:/app/data:Z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
