# live bazzite stack writes them under VEFR_HOME/data.
/data/sessions/
/data/vault-*.json
/data/journal-*.json
/data/trace.jsonl
/data/trace.jsonl.old
/data/weave.jsonl
/data/weave.jsonl.old
