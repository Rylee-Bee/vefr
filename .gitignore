__pycache__/
.venv/
*.egg-info/
.pytest_cache/

# engine-shipped worlds (sample-world, lore packs) are tracked.
# any author-imported world pack is gitignored - the bones
# stay empty until the author mounts a pack. Historically this
# rule named a specific pack; the convention is that any
# non-shipped pack under worlds/ is author-canon and ignored.
# the norns CLI uses `ferry fetch --pack <name>` to import.
# local environment config - copied from example.env, per-machine.
# never commit: the LAN leaves the source, runtime data not repo data.
/.env

# local deploy config - the per-host twin of deploy.toml.example
# (the example documents the convention; this file holds the values).
/deploy.toml

# build output
/dist/

# derived per-pack artifacts (norns handbok, world-tree view).
# regenerated by the engine; never commit.
/worlds/*/world-tree.md
/worlds/*/handbok.md

# runtime state - per-session journals/vaults and fork metadata.
# never commit: these are session data, not engine code. The runtime
# writes them under VEFR_HOME/data on the deploy host.
/data/sessions/
/data/vault-*.json
/data/journal-*.json
/data/trace.jsonl
/data/trace.jsonl.old
/data/weave.jsonl
/data/weave.jsonl.old
/data/handoffs/

# user-installed Storyteller Packs. Tracked packs ship in
# storyteller_packs/ at the repo root; everything under
# data/storytellers/ is a per-machine install (mirrors of upstream
# model weights, local configs, eval-only packs like qwen25-3b).
/data/storytellers/

# agent research surveys - local session notes, not engine docs.
# the repo may publish one day; durable decisions live in
# ROADMAP.md, idea credits in README.
/docs/guides/companion-resources.md

# private canon-audit list - the gate enforces it locally, never ships
tests/canon-strings.local.txt

# JetBrains local project state - never part of the engine.
.idea/

# runtime journal single-file (siblings ignored since the runtime-data rule)
/data/journal.json
web/static

# Generated content index (agent-config). Regenerable; binary; contains
# absolute home paths, so it must never reach a public repo.
data/content.db
**/data/content.db
