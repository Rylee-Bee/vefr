# vefr - example environment file.
#
# Copy to `.env` (gitignored) and fill in your values. Source it
# before any entry point - the engine reads plain process env vars,
# it never reads this file itself:
#
#     set -a; source .env; set +a
#     uv run uvicorn vefr.main:app --app-dir src --port 8820
#
# The engine source carries neutral localhost defaults and takes its
# identity from the environment - runtime config, not repo data.
# See GETTING_STARTED.md for the full variable table.

# The model backend. VEFR_LLAMACPP_URL (an OpenAI-compatible
# /v1/chat/completions endpoint, e.g. llama.cpp's llama-server)
# is the primary transport; OLLAMA_URL is the legacy fallback.
# For broad playability, point one of them at a small local model
# the current machine can actually run. If both are set,
# VEFR_LLAMACPP_URL wins.
# Default when unset: http://127.0.0.1:8081 / http://127.0.0.1:11434
VEFR_LLAMACPP_URL=http://127.0.0.1:8081
# OLLAMA_URL=http://127.0.0.1:11434

# The served model name (passed to the endpoint as `model`).
# VEFR_MODEL=gpt-oss-20b

# Which pack to load from worlds/. Default: sample-world.
# VEFR_WORLD=sample-world

# Repo identity for the ferry/deploy tooling - set to YOUR hosts.
# Neutral localhost defaults apply when unset.
# VEFR_GITEA_URL=https://git.example.com/user/vefr.git
# VEFR_LIVE_URL=http://localhost:8820
# VEFR_DEPLOY_HOST=user@deploy-host

# Storyteller - the voice that renders scenes.
# Default: ministral3-3b (Ministral 3 3B Q4_K_M, canonical selection
# from Small Model Quick Finals 2026-09-13). Fallback: phi-4-mini-instruct
# (faster but weaker on multi-turn continuity).
# See docs/adr/0002-default-storyteller-selection.md for evidence.
#VEFR_STORYTELLER=ministral3-3b

# Spark - the resident small brain (see docs/guides/spark.md).
# VEFR_SPARK_URL is Spark's llama.cpp endpoint; escalation work still
# goes to VEFR_LLAMACPP_URL (the stronger model) untouched.
#VEFR_SPARK_URL=http://127.0.0.1:8082
# spark-quality (Phi-4-mini Q4_K_M, default) or spark-tiny
# (Qwen3.5-0.8B Q8_0 - never Q4 on sub-1B models).
#VEFR_SPARK_PROFILE=quality

# Interface Translator (vefr-interface) - maps player language onto
# the engine's canonical action vocabulary. Always loopback; never use
# IPv6 localhost. Port 8085 is the unambiguous default (8081 = engine,
# 8082 = Spark/embed, 11436/11437 = 9B servers).
# Default model: qwen3.5-9b-mtp (won bench/interface; the 1.5B/0.8B
# candidates reach 100% schema validity but fail the safety boundary).
#VEFR_INTERFACE_URL=http://127.0.0.1:8085
#VEFR_INTERFACE_MODEL=qwen3.5-9b-mtp
